    {
      "id": "XGvv7na-uL8hQgfpzQr7I",
      "type": "text",
      "x": 5214.573148990545,
      "y": 2198.392891105643,
      "width": 574.031494140625,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#15aabf",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1i",
      "roundness": null,
      "seed": 1591135502,
      "version": 227,
      "versionNonce": 1443375250,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "3boJMNDsbqduh_JTr81GV",
          "type": "arrow"
        },
        {
          "id": "-8aAaGsbgxqX3S7YEevmm",
          "type": "arrow"
        }
      ],
      "updated": 1791241325989,
      "created": 1791241291785,
      "link": null,
      "locked": false,
      "text": "Flush slot as soon as they are filled and immediately assign another work\nto the worker",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Flush slot as soon as they are filled and immediately assign another work\nto the worker",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "IMK12yW1uM0LMsqsjCIZ5",
      "type": "text",
      "x": 4819.613054201595,
      "y": 2743.1606984101445,
      "width": 772.319580078125,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#15aabf",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1iG",
      "roundness": null,
      "seed": 1805852626,
      "version": 858,
      "versionNonce": 540167246,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791241535968,
      "created": 1791241363474,
      "link": null,
      "locked": false,
      "text": "The problem with this approach is it is difficult to find the appropriate offset in the\nfinal (output) buffer for the slot, \n\nfor example: \nSlot 3 were written first, filled, then flushed, and Worker 3 is assigned another work, meanwhile\nslot 1 has not been written, and now slot 3 appears as if the result has not arrived, while in fact \nit is already flushed and waiting for the next arrival.\n\nwhere do we write the previous slot 3 result to ? how do we preserve the order",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The problem with this approach is it is difficult to find the appropriate offset in the\nfinal (output) buffer for the slot, \n\nfor example: \nSlot 3 were written first, filled, then flushed, and Worker 3 is assigned another work, meanwhile\nslot 1 has not been written, and now slot 3 appears as if the result has not arrived, while in fact \nit is already flushed and waiting for the next arrival.\n\nwhere do we write the previous slot 3 result to ? how do we preserve the order",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "sG586UcAPXY0wtxFX740K",
      "type": "text",
      "x": 3488.8747071090143,
      "y": 2757.693153759781,
      "width": 800,
      "height": 100,
