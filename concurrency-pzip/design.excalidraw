    {
      "id": "O4Y2kQeXzZXAIWnr_l6U3",
      "type": "text",
      "x": 487.6193842434118,
      "y": 2413.5722894947276,
      "width": 538.2196044921875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e8590c",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aDqV",
