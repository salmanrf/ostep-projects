    {
      "id": "TetXDVxgC2HUN2O952PFr",
      "type": "text",
      "x": 2238.8646703490735,
      "y": 3474.5893736027324,
      "width": 530.9596557617188,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e8590c",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aDqC",
      "roundness": null,
      "seed": 1487861138,
      "version": 2231,
      "versionNonce": 831373070,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791327790479,
      "created": 1791327430756,
      "link": null,
      "locked": false,
      "text": "1. Init current_batch_size\n2. Init batch buffer\n3. Check if current_batch_size >= MAX_BATCH_SIZE\n    true: - call in = get_work\n           - push in to batch buffer\n    else: return\n4. Repeat step 3",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Init current_batch_size\n2. Init batch buffer\n3. Check if current_batch_size >= MAX_BATCH_SIZE\n    true: - call in = get_work\n           - push in to batch buffer\n    else: return\n4. Repeat step 3",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "pzN5tPCZBPjeYk3yIgkGV",
